      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "dashboard_contadores_faltantes{env=\"$env\"}", "datasource": { "type": "prometheus", "uid": "eezd2pur0jy80e" }, "legendFormat": "{{device_identification}}" }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Contadores desactualizados",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "eezd2pur0jy80e" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "dashboard_contadores_desactualizados{env=\"$env\"}", "datasource": { "type": "prometheus", "uid": "eezd2pur0jy80e" }, "legendFormat": "{{device_identification}}" }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Resets de contadores detectados",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "eezd2pur0jy80e" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (device_identification) (increase(dashboard_contadores_resets_total{env=\"$env\"}[5m]))", "datasource": { "type": "prometheus", "uid": "eezd2pur0jy80e" }, "legendFormat": "{{device_identification}}" }
      ]
    }
  ]
}
